          {!isToday && <button onClick={goToday} className="text-sm text-purple-400 underline">Go to Today</button>}
        </div>
        <p className="text-sm text-zinc-400">{dayNames[currentDayOfWeek]}, {selectedDate.toLocaleDateString()}</p>
        
        <div className="flex justify-between gap-1">
          {dayOrder.map(d => {
            const isSelected = d === currentDayOfWeek;
            const diff = d - currentDayOfWeek;
            const actualDate = new Date(selectedDate);
            actualDate.setDate(actualDate.getDate() + diff);
            const isTodayPill = dateKey(actualDate) === dateKey(new Date());
            
            return (
              <button 
                key={d} 
                onClick={() => {
                  const newDate = new Date(selectedDate);
                  newDate.setDate(newDate.getDate() + (d - currentDayOfWeek));
                  setSelectedDate(newDate);
                }}
                className={`flex-1 py-2 rounded-lg text-center text-xs font-medium transition-all
                  ${isSelected ? 'bg-purple-600 text-white' : 'bg-zinc-800 text-zinc-400 hover:bg-zinc-700'}
                  ${isTodayPill && !isSelected ? 'ring-2 ring-purple-400' : ''}`}
              >
                {dayNamesShort[d]}
              </button>
            );
          })}
        </div>

        {!hasSupps ? (
          <div className="text-center py-12 text-zinc-500"><I.Pill s={48} c="mx-auto mb-4 opacity-50"/><p>No supplements for this account</p></div>
        ) : (
          <>
            {proto.daily.length > 0 && (
              <div className="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden">
                <div className="px-4 py-3 bg-zinc-800/50 border-b border-zinc-800 flex items-center gap-2"><I.Sun s={18} c="text-amber-400"/><span className="font-semibold">Daily - Morning (Fasted)</span></div>
                <div className="divide-y divide-zinc-800">
                  {proto.daily.map(it => (
                    <button key={it.id} onClick={()=>togSupp(it.id)} className="w-full px-4 py-3 flex items-center justify-between hover:bg-zinc-800/50">
                      <div className="flex items-center gap-3">
                        <div className={`w-6 h-6 rounded-full flex items-center justify-center ${suppDone(it.id)?'bg-emerald-500':'border-2 border-zinc-600'}`}>{suppDone(it.id)&&<I.Check s={14}/>}</div>
                        <div className="text-left"><div className={suppDone(it.id)?'line-through text-zinc-500':'font-medium'}>{it.name}</div><div className="text-sm text-zinc-400 font-mono">{it.dose}</div></div>
                      </div>
                      <span className={`text-xs px-2 py-1 rounded ${it.type==='peptide'?'bg-blue-500/20 text-blue-400':'bg-green-500/20 text-green-400'}`}>{it.type}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}
            {todayWeekly.length > 0 && (
              <div className="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden">
                <div className="px-4 py-3 bg-zinc-800/50 border-b border-zinc-800 flex items-center gap-2"><I.Syringe s={18} c="text-red-400"/><span className="font-semibold">{dayNames[currentDayOfWeek]} Injections</span></div>
                <div className="divide-y divide-zinc-800">
                  {todayWeekly.map(it => (
                    <button key={it.id} onClick={()=>togSupp(it.id)} className="w-full px-4 py-3 flex items-center justify-between hover:bg-zinc-800/50">
                      <div className="flex items-center gap-3">
                        <div className={`w-6 h-6 rounded-full flex items-center justify-center ${suppDone(it.id)?'bg-emerald-500':'border-2 border-zinc-600'}`}>{suppDone(it.id)&&<I.Check s={14}/>}</div>
                        <div className="text-left"><div className={suppDone(it.id)?'line-through text-zinc-500':'font-medium'}>{it.name}</div><div className="text-sm text-zinc-400 font-mono">{it.dose}</div></div>
                      </div>
                      <span className={`text-xs px-2 py-1 rounded ${it.type==='injection'?'bg-red-500/20 text-red-400':'bg-purple-500/20 text-purple-400'}`}>{it.type}</span>
                    </button>
                  ))}
                </div>
              </div>
            )}
            <div className="bg-zinc-900 border border-zinc-800 rounded-xl p-4">
              <h3 className="font-semibold mb-3">Weekly Schedule</h3>
              <div className="space-y-2 text-sm">
                {proto.weekly.map(it => <div key={it.id} className="flex justify-between"><span>{it.name} <span className="font-mono text-purple-400">({it.dose})</span></span><span className="text-zinc-500">{it.days.map(d=>dayNames[d].slice(0,3)).join(' & ')}</span></div>)}
              </div>
            </div>
            
            <div className="bg-zinc-900 border border-zinc-800 rounded-xl p-4">
              <h3 className="font-semibold mb-3">Reconstitution Reference</h3>
              <div className="space-y-2 text-xs">
                <div className="grid grid-cols-4 text-zinc-500 border-b border-zinc-800 pb-2">
                  <span>Peptide</span><span className="text-center">Vial</span><span className="text-center">Water</span><span className="text-right">Per Unit</span>
                </div>
                {reconstitution.map(r => (
                  <div key={r.name} className="grid grid-cols-4 text-zinc-300">
                    <span>{r.name}</span>
                    <span className="text-center">{r.vial}</span>
                    <span className="text-center">{r.water}</span>
                    <span className="text-right font-mono text-purple-400">{r.conc}</span>
                  </div>
                ))}
              </div>
            </div>
          </>
        )}
      </div>
    )}

    {view === 'calendar' && (
      <div className="space-y-4">
        <h2 className="text-xl font-bold mb-4">Weekly Schedule</h2>
        
        <div className="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden">
          {dayOrder.map(d => {
            const wo = workouts[d];
            const today = new Date();
            const isToday = d === today.getDay();
            
            return (
              <button 
                key={d} 
                onClick={() => { 
                  const newDate = new Date();
                  const diff = d - today.getDay();
                  newDate.setDate(newDate.getDate() + diff);
                  setSelectedDate(newDate); 
                  setView('workout'); 
                }}
                className={`w-full px-4 py-4 flex justify-between items-center border-b border-zinc-800 last:border-0 hover:bg-zinc-800/50 ${isToday ? 'bg-purple-600/20' : ''}`}
              >
                <div className="flex items-center gap-3">
                  <div className={`w-10 h-10 rounded-lg flex items-center justify-center text-sm font-bold ${isToday ? 'bg-purple-600' : 'bg-zinc-800'}`}>
                    {dayNamesShort[d]}
                  </div>
                  <div className="text-left">
                    <div className="font-semibold">{wo.name}</div>
                    <div className="text-sm text-zinc-400">{wo.focus}</div>
                  </div>
                </div>
                {isToday && <span className="text-xs bg-purple-600 px-2 py-1 rounded-full">Today</span>}
              </button>
            );
          })}
        </div>

        <div className="bg-zinc-900 border border-zinc-800 rounded-xl p-4">
          <h3 className="font-semibold mb-3">Injection Days</h3>
          <div className="space-y-2 text-sm">
            <div className="flex items-center gap-2">
              <span className="w-16 text-zinc-500">Tue & Thu</span>
              <span>TRT + TB-500</span>
            </div>
            <div className="flex items-center gap-2">
              <span className="w-16 text-zinc-500">Thu</span>
              <span>Tirzepatide</span>
            </div>
          </div>
        </div>
      </div>
    )}
  </main>

  <nav className="fixed bottom-0 left-0 right-0 bg-zinc-900 border-t border-zinc-800 safe-bottom">
    <div className="flex justify-around py-2">
      {[{id:'workout',icon:I.Dumbbell,label:'Workout'},{id:'supplements',icon:I.Pill,label:'Supplements'},{id:'calendar',icon:I.Calendar,label:'Calendar'}].map(t => (
        <button key={t.id} onClick={()=>setView(t.id)} className={`flex flex-col items-center py-2 px-4 ${view===t.id?'text-purple-400':'text-zinc-500'}`}><t.icon s={24}/><span className="text-xs mt-1">{t.label}</span></button>
      ))}
    </div>
  </nav>
</div>
