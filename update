const [loading, setLoading] = useState(true);
const [saved, setSaved] = useState(false);

const currentDayOfWeek = selectedDate.getDay();

useEffect(() => {
const s = localStorage.getItem(‘iron_session’);
if (s) {
try {
const { user: u, ts } = JSON.parse(s);
if (Date.now() - ts < 24*60*60*1000) { loadUser(u); return; }
} catch {}
}
setLoading(false);
}, []);

const loadUser = async n => {
const d = await load(n);
if (d) { setLogs(d.logs||{}); setSuppLogs(d.suppLogs||{}); }
setUser(n);
localStorage.setItem(‘iron_session’, JSON.stringify({ user: n, ts: Date.now() }));
setLoading(false);
};

useEffect(() => { if (user) save(user, { logs, suppLogs }); }, [logs, suppLogs, user]);

const logout = () => { localStorage.removeItem(‘iron_session’); setUser(null); setLogs({}); setSuppLogs({}); };
const flash = () => { setSaved(true); setTimeout(() => setSaved(false), 1200); };

const lk = (date, dayOfWeek, exerciseIdx) => `${getWeekKey(date)}-${dayOfWeek}-${exerciseIdx}`;

const upLog = (e,s,f,v) => {
setLogs(p => ({
…p,
[lk(selectedDate, currentDayOfWeek, e)]: {
…(p[lk(selectedDate, currentDayOfWeek, e)]||{sets:{}}),
sets: {
…(p[lk(selectedDate, currentDayOfWeek, e)]?.sets||{}),
[s]: {
…(p[lk(selectedDate, currentDayOfWeek, e)]?.sets?.[s]||{}),
[f]: v
}
}
}
}));
flash();
};

