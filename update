dalton: hashPin(‘0000’)
};

const DB = ‘IronProtocolDB_v8’;
const openDB = () => new Promise((res, rej) => {
const r = indexedDB.open(DB, 1);
r.onerror = () => rej(r.error);
r.onsuccess = () => res(r.result);
r.onupgradeneeded = e => e.target.result.createObjectStore(‘data’, { keyPath: ‘id’ });
});
const save = async (id, data) => {
const db = await openDB();
return new Promise(res => {
const tx = db.transaction(‘data’, ‘readwrite’);
tx.objectStore(‘data’).put({ id, …data, ts: Date.now() });
tx.oncomplete = () => res(true);
});
};
const load = async (id) => {
const db = await openDB();
return new Promise(res => {
const r = db.transaction(‘data’, ‘readonly’).objectStore(‘data’).get(id);
r.onsuccess = () => res(r.result);
});
};

